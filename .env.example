# Render configura PORT automáticamente, pero puedes dejar este valor para local.
PORT=10000

# Para pruebas internas puedes dejar *.
# Cuando tengas Netlify, cambia por: https://tu-sitio.netlify.app
ALLOWED_ORIGIN=*

# Límite de carga del ZIP. Para MVP se recomienda 80-150 MB.
MAX_UPLOAD_MB=120

# Este MVP 1 funciona sin OpenAI.
# Más adelante se puede usar IA para leer imágenes y mejorar clasificación.
OPENAI_API_KEY=
